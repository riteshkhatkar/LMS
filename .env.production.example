# ==============================================================================
# Learn LMS — Production Environment Configuration Template
# Platform: Learn LMS | Product by ORELSE (https://www.orelse.ai)
# ==============================================================================

# -------------------------------------------------------------
# 1. Application URLs & Network Binding
# -------------------------------------------------------------
# Canonical domain for Learn LMS (must use https:// in production)
NEXT_PUBLIC_APP_URL="https://learn.orelse.ai"
NEXT_PUBLIC_SITE_URL="https://learn.orelse.ai"
PORT=3000
HOSTNAME="0.0.0.0"

# -------------------------------------------------------------
# 2. Database Connection (PostgreSQL 18)
# -------------------------------------------------------------
# Production PostgreSQL connection string with SSL mode enabled (sslmode=require)
DATABASE_URL="postgresql://learnlms_user:STRONG_SECURE_PASSWORD@pg-cluster.internal:5432/learnlms_prod?schema=public&sslmode=require&connection_limit=20&pool_timeout=10"

# -------------------------------------------------------------
# 3. Stateless Session Authentication (JWT HS256)
# -------------------------------------------------------------
# Cryptographically strong random key (minimum 64 characters / 256 bits of entropy)
# Generate with: openssl rand -base64 48
JWT_SECRET="GENERATE_AND_PASTE_A_64_CHAR_CRYPTOGRAPHIC_SECRET_HERE"

# -------------------------------------------------------------
# 4. ORELSE Digital Credential & Verification Authority
# -------------------------------------------------------------
CERTIFICATE_ISSUER_NAME="ORELSE"
CERTIFICATE_ISSUER_URI="https://learn.orelse.ai/issuer/orelse"
CERTIFICATE_ISSUER_ID="ORELSE-PROD-ISSUER-001"
CERTIFICATE_PROGRAMME="ORELSE Learning Certification"

# Private key for ES256 credential signing (ECDSA P-256)
# Keep in secure KMS / HSM or inject as environment secret. Never commit to git!
# In production, this can be loaded from file or base64-encoded secret.
ORELSE_SIGNER_KEY_PATH="/etc/learnlms/keys/orelse-signer-es256.json"

# -------------------------------------------------------------
# 5. Blockchain Anchoring & Ledger Configuration
# -------------------------------------------------------------
# Options: "mock" (offline/zero-dependency), "local_evm", or "public_testnet"
# Set to "mock" until on-chain contracts and funding are explicitly verified
LEDGER_MODE="mock"

# Production EVM RPC URL and authorized contract address
# EVM_RPC_URL="https://polygon-rpc.com"
# EVM_CHAIN_ID="137"
# EVM_CONTRACT_ADDRESS="0x..."
# EVM_SIGNER_PRIVATE_KEY=""

# -------------------------------------------------------------
# 6. Email Delivery & Newsletter Dispatch (SMTP)
# -------------------------------------------------------------
# Production SMTP provider (e.g. AWS SES, SendGrid, Postmark)
# Leave unset to use LocalDemoDeliveryAdapter (simulated delivery)
# SMTP_HOST="smtp.mailprovider.com"
# SMTP_PORT="587"
# SMTP_USER="mailer@orelse.ai"
# SMTP_PASSWORD="STRONG_SMTP_PASSWORD"
# SMTP_FROM_EMAIL="learn@orelse.ai"
# SMTP_FROM_NAME="Learn LMS — ORELSE"

# -------------------------------------------------------------
# 7. Operational Observability & Logging
# -------------------------------------------------------------
LOG_LEVEL="INFO"
NODE_ENV="production"
