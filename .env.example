# Learn LMS — Environment Variables Configuration

# Application URL (Used for QR codes, verification links, and issuer URI)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://postgres:password@localhost:5432/learnlms"

# Stateless Session Authentication (jose JWT HS256)
JWT_SECRET="learn_lms_super_secret_jwt_key_2026_dev_env_987654321"

# -------------------------------------------------------------
# Phase 4: ORELSE Digital Certification & Blockchain Anchoring
# -------------------------------------------------------------

# Certificate Issuer Metadata
CERTIFICATE_ISSUER_NAME="ORELSE"
CERTIFICATE_ISSUER_URI="http://localhost:3000/issuer/orelse"
CERTIFICATE_ISSUER_ID="ORELSE-DEMO-ISSUER-001"
CERTIFICATE_PROGRAMME="ORELSE Learning Certification"

# Ledger Mode: "mock" (default, zero external dependency), "local_evm", or "public_testnet"
LEDGER_MODE="mock"

# Optional EVM Testnet Configuration (Polygon Amoy Testnet Chain ID 80002)
# Only required when LEDGER_MODE="public_testnet" or deploying contracts
EVM_RPC_URL="https://rpc-amoy.polygon.technology"
EVM_CHAIN_ID="80002"
EVM_CONTRACT_ADDRESS=""
EVM_SIGNER_PRIVATE_KEY=""

# -------------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect Authentication
# -------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
